OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
MOCK_MODE=true
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787

# Studio connector credentials (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SLACK_USER_TOKEN=

# Local production tools
STUDIO_ROOT=
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
BAMBU_STUDIO_PATH=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio

# Experimental Bambu LAN-mode connector
BAMBU_PRINTER_HOST=
BAMBU_PRINTER_SERIAL=
BAMBU_ACCESS_CODE=

# At least 24 random characters; required for the mobile controller API
CONTROLLER_TOKEN=

# Operator-owned HTTP bridges. Tokens stay server-side.
# CUSTOM_CONNECTORS_JSON=[{"name":"asset_manager","url":"https://studio.example/api/radian","token":"replace-me","mutating":false}]
CUSTOM_CONNECTORS_JSON=[]
